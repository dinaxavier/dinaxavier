# ============================================
# CONFIGURAÇÃO DO AGENTE MONITOR DE VOOS
# ============================================

# --------------------------------------------
# BUSCA DE VOOS
# --------------------------------------------

# Europa — origens no Brasil
ORIGENS=GRU,CGH,VCP

# Europa e Islândia — destinos (códigos IATA)
# CDG Paris, LIS Lisboa, BCN Barcelona, MAD Madri (Espanha)
# FCO Roma e MXP Milão (Itália), LON Londres, KEF Reykjavík (Islândia)
DESTINOS=CDG,LIS,BCN,FCO,MXP,MAD,LON,KEF

# Uruguai (MVD Montevidéu) e Argentina (EZE Buenos Aires)
ORIGENS_AMERICA_SUL=GRU,CGH,VCP
DESTINOS_AMERICA_SUL=MVD,EZE

# África do Sul saindo de Belo Horizonte (CNF Confins)
# JNB Joanesburgo, CPT Cidade do Cabo
ORIGENS_AFRICA=CNF
DESTINOS_AFRICA=JNB,CPT

# Canadá — Montreal (YUL) e Quebec (YQB), saindo de Guarulhos e Orlando
ORIGENS_CANADA=GRU,MCO
DESTINOS_CANADA=YUL,YQB

# Janela de datas de ida (formato YYYY-MM-DD)
DATA_IDA_INICIO=2026-12-01
DATA_IDA_FIM=2027-03-31

# Janela de datas de volta (formato YYYY-MM-DD)
DATA_VOLTA_INICIO=2026-12-08
DATA_VOLTA_FIM=2027-04-07

# Número de passageiros
PASSAGEIROS=1

# Preço máximo por pessoa (em R$)
PRECO_MAXIMO=3000

# Desconto mínimo para considerar oportunidade (%)
DESCONTO_MINIMO=15

# Preferência por voos diretos
VOO_DIRETO=false

# Número máximo de conexões aceitas
MAX_CONEXOES=2

# Aceitar mudança de aeroporto nas conexões
ACEITAR_MUDANCA_AEROPORTO=false

# --------------------------------------------
# BUSCA DE MILHAS
# --------------------------------------------

# Programas de fidelidade monitorados
PROGRAMAS_MILHAS=Smiles,Latam Pass,Livelo,TudoAzul

# Custo máximo por milheiro em centavos (350 = R$ 3,50)
CUSTO_MAXIMO_MILHEIRO=350

# Desconto mínimo para promoções de milhas (%)
DESCONTO_MINIMO_MILHAS=10

# --------------------------------------------
# INTEGRAÇÃO KIWI.COM (OBRIGATÓRIO)
# --------------------------------------------

# Chave da API Kiwi.com (obter em https://partners.kiwi.com/)
KIWI_API_KEY=sua-chave-api-aqui

# --------------------------------------------
# ARMAZENAMENTO
# --------------------------------------------

# Diretório onde os arquivos CSV serão salvos
CSV_DATA_DIR=./data

# --------------------------------------------
# CONFIGURAÇÕES OPCIONAIS
# --------------------------------------------

# Ambiente (development | production)
NODE_ENV=development

# Nível de log (debug | info | warn | error)
LOG_LEVEL=info
